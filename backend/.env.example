PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_ACCESS_SECRET=generate_a_random_string_of_at_least_32_characters
JWT_REFRESH_SECRET=generate_a_different_random_string_of_at_least_32_characters
CLIENT_URL=http://localhost:3000
TRUST_PROXY=
ADMIN_EMAIL=minhasvirtual@gmail.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Email: Resend is used when RESEND_API_KEY is set (needs a verified domain);
# otherwise, or if Resend fails, SMTP below is used. Fill in one or both.
RESEND_API_KEY=
MAIL_FROM=Vaultrix <noreply@vaultrix.org>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EXTRA_BLOCKED_EMAIL_DOMAINS=
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=vaultrix
